# All optional. The site runs with none of these set.
# Contact string sent in the User-Agent to Wikimedia, MusicBrainz and others. Set this before deploying.
CONTACT_EMAIL=
# https://api.nasa.gov — enables the APOD adapter. When last tested the API was returning placeholders.
NASA_API_KEY=
# https://www.themoviedb.org/settings/api — non-commercial licence; enables film posters and extra releases.
TMDB_API_KEY=
# https://open-platform.theguardian.com/access — enables reported headlines from 1999 onwards.
GUARDIAN_API_KEY=
# https://openalex.org/settings/api — raises the daily research-paper budget.
OPENALEX_API_KEY=
# Optional paid or personal key for TheSportsDB; the free public key "123" is used otherwise.
THESPORTSDB_API_KEY=
# Canonical origin for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
